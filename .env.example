# ── Telegram ───────────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ── Google Gemini ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── CloudShop ─────────────────────────────────────────────────────────────────
CS_EMAIL=your@email.com
CS_PASSWORD=your_password
CS_URL=https://your.cloudshop.url

# ── Информация о магазине (для команды "О нас") ────────────────────────────────
SHOP_ADDRESS=г. Ташкент, ул. Примерная, д. 1
SHOP_PHONE=+998 XX XXX XX XX
SHOP_TELEGRAM=@hobbygames_uz

# ── Путь к Excel-каталогу ──────────────────────────────────────────────────────
# Колонки: A=Название | B=Жанр | C=Возраст | D=Игроки | E=Теги
EXCEL_CATALOG_PATH=catalog.xlsx

# ── ID администраторов (через запятую) ────────────────────────────────────────
# Команды: /relogin /status /reload /clearcache
ADMIN_IDS=123456789,987654321
